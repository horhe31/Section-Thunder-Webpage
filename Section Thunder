    <style>
        body {
            background-color: #040406;
            color: #f4f4f7;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }
        /* Custom Premium Glassmorphic Textures */
        .glass-nav {
            background: rgba(4, 4, 6, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .glass-widget {
            background: rgba(11, 11, 16, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        /* Premium Ambient Glowing Specifications */
        /* Configured exactly to instructions: 20px blur radius with 15% opacity shadows */
        .thunder-glow {
            box-shadow: 0 10px 20px rgba(168, 85, 247, 0.15);
        }
        .thunder-glow-intense {
            box-shadow: 0 0 20px rgba(192, 132, 252, 0.15);
        }
        .glow-zinc {
            box-shadow: 0 8px 20px rgba(63, 63, 70, 0.15);
        }

        /* High Performance Smooth CSS Animation Profiles */
        .fade-in-smooth {
            animation: fadeIn 0.45s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Game Board Color Map Nodes for 2048 Grid Tiles */
        .tile-2 { background-color: #3e3e4d; color: #ffffff; }
        .tile-4 { background-color: #4d4d66; color: #ffffff; }
        .tile-8 { background-color: #f2b179; color: #000000; font-weight: 900; }
        .tile-16 { background-color: #f59563; color: #ffffff; font-weight: 900; }
        .tile-32 { background-color: #f67c5f; color: #ffffff; font-weight: 900; }
        .tile-64 { background-color: #f65e3b; color: #ffffff; font-weight: 900; }
        .tile-128 { background-color: #edcf72; color: #000000; font-weight: 900; box-shadow: 0 0 5px #edcf72; }
        .tile-256 { background-color: #edcc61; color: #000000; font-weight: 900; box-shadow: 0 0 8px #edcc61; }
        .tile-512 { background-color: #edc850; color: #ffffff; font-weight: 900; box-shadow: 0 0 12px #edc850; }
        .tile-1024 { background-color: #edc53f; color: #ffffff; font-weight: 900; box-shadow: 0 0 16px #edc53f; }
        .tile-2048 { background-color: #e50914; color: #ffffff; font-weight: 900; box-shadow: 0 0 24px #e50914; }

        /* Custom Layout Scrollers */
        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #1b1b26; border-radius: 2px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #2a2a3d; }
    </style>
</head>
